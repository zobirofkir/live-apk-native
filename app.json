{
  "expo": {
    "name": "Live Streaming App",
    "slug": "live-streaming-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.livestreaming.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.livestreaming.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "config": {
        "expo": {
          "video": {
            "enableHardwareAcceleration": true
          }
        }
      },
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "android": {
            "gradleCommand": ":app:assembleRelease"
          }
        },
        "projectId": "2a6e4e04-c1f3-47ab-895a-735d5cc4d907"
      }
    }
  }
}
