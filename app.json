{
  "expo": {
    "name": "Live Streaming App",
    "slug": "live-streaming-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.livestreaming.app"
    },
    "android": {
      "package": "com.livestreaming.app",
      "permissions": ["CAMERA", "RECORD_AUDIO", "INTERNET"]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ]
  }
}
